SHELL := /bin/sh

PROJECT_DIR := @PROJECT_DIR@
FPC := @FPC@
PYTHON := @PYTHON@
# DESTDIR: the standard staging prefix every packaging tool sets. Without it
# 'make install' wrote to the real /usr even inside a fakeroot, so no package
# could be built from this Makefile.
DESTDIR ?=
PREFIX := @PREFIX@
BINDIR := @BINDIR@
SYSCONFDIR := @SYSCONFDIR@
DOCDIR := @DOCDIR@
DATADIR := @DATADIR@

MODE ?= release
TARGET ?= $(PROJECT_DIR)/bin/superterm
UNITDIR ?= $(PROJECT_DIR)/build/units/$(MODE)
FPCFLAGS_EXTRA ?=

# -vewnh: errors, warnings, notes and hints all on -- the project builds with
# none of them. -vm11030,11031 silences the two FPC emits about reading its
# own /etc/fpc.cfg, which say nothing about this code and made a clean build
# look like it had something to report.
BASE_FLAGS := -Mobjfpc -Sh -vewnh -vm11030,11031 \
  -Fu$(PROJECT_DIR)/vendor/fv322 \
  -FU$(UNITDIR) \
  -FE$(PROJECT_DIR)/bin

ifeq ($(MODE),debug)
# -Crtoi explicito: /etc/fpc.cfg lo activa via su rama "#IFDEF DEBUG", pero
# el build no debe depender del config global para sus checks de runtime
MODE_FLAGS := -O1 -g -gl -dDEBUG -Crtoi
else ifeq ($(MODE),release)
# -gl: line information, kept in the optimised build on purpose. A crash
# report from a release binary carried bare addresses that resolved to
# nothing, which is exactly when the report matters most; with this the
# backtrace names the file and line. It does not change the code generated.
MODE_FLAGS := -O4 -gl
else
$(error MODE must be release or debug)
endif

SOURCES := $(wildcard $(PROJECT_DIR)/src/*.pas) \
  $(wildcard $(PROJECT_DIR)/src/*.lpr) \
  $(wildcard $(PROJECT_DIR)/vendor/fv322/*.pas) \
  $(wildcard $(PROJECT_DIR)/vendor/fv322/*.inc)

TESTS := drive_test.py large_screen_test.py mouse_test.py \
  mouse_focus_test.py focus_color_test.py restore_test.py sysconfig_test.py \
  template_test.py sqlite_test.py wizard_test.py language_test.py clipboard_test.py \
  window_test.py cursor_test.py wclass_test.py profile_test.py multisession_test.py prefix_test.py title_test.py detach_test.py control_test.py cli_test.py control_wm_test.py multiclient_test.py alwaysserver_test.py passthrough_test.py exit_clean_test.py newwindow_test.py appcursor_test.py scrollback_test.py nesting_test.py mouseforward_test.py remote_newpane_test.py fullscreen_test.py empty_desktop_test.py mousemode_test.py dialog_opaque_test.py \
  badclass_test.py passthrough_modes_test.py resize_keep_test.py

.PHONY: all release debug test install uninstall install-deps clean distclean info

all: $(TARGET)

# la version se toma del fichero VERSION y se inyecta como include
$(PROJECT_DIR)/src/st_version.inc: $(PROJECT_DIR)/VERSION
	printf "const SUPERTERM_VERSION = '%s';\n" "$$(cat $(PROJECT_DIR)/VERSION)" \
		> $(PROJECT_DIR)/src/st_version.inc

$(TARGET): $(SOURCES) $(PROJECT_DIR)/src/st_version.inc $(PROJECT_DIR)/config.status
	@mkdir -p "$(UNITDIR)" "$(PROJECT_DIR)/bin"
	$(FPC) $(BASE_FLAGS) $(MODE_FLAGS) $(FPCFLAGS_EXTRA) \
		-o$(TARGET) $(PROJECT_DIR)/src/superterm.lpr

release:
	$(MAKE) MODE=release TARGET=$(PROJECT_DIR)/bin/superterm all

debug:
	$(MAKE) MODE=debug TARGET=$(PROJECT_DIR)/bin/superterm-debug all

test: release
	@if [ -z "$(PYTHON)" ]; then \
		printf '%s\n' 'Python 3 is required for tests'; exit 1; \
	fi
	@$(PYTHON) -c 'import pyte' 2>/dev/null || \
		(printf '%s\n' 'Python module pyte is required; install python3-pyte or run pip install pyte'; exit 1)
	@failed=''; total=0; for test in $(TESTS); do \
		printf '\n==> test/%s\n' "$$test"; \
		total=$$((total + 1)); \
		$(PYTHON) "$(PROJECT_DIR)/test/$$test" || failed="$$failed $$test"; \
	done; \
	printf '\n---------------------------------------------\n'; \
	if [ -n "$$failed" ]; then \
		printf 'FAILED suites (of %s):\n' "$$total"; \
		for t in $$failed; do printf '  test/%s\n' "$$t"; done; \
		exit 1; \
	fi; \
	printf 'all %s suites passed\n' "$$total"

# Regenerate this Makefile when its template or configure changes. An existing
# checkout otherwise keeps a stale Makefile after a pull -- which is how a new
# install path (the desktop backgrounds directory) silently went missing.
Makefile: $(PROJECT_DIR)/Makefile.in $(PROJECT_DIR)/configure
	@printf '%s\n' "Makefile.in or configure changed; re-running ./configure"
	@cd "$(PROJECT_DIR)" && ./configure

install: release
	@mkdir -p "$(DESTDIR)$(BINDIR)" "$(DESTDIR)$(DOCDIR)" "$(DESTDIR)$(SYSCONFDIR)/superterm"
	install -m 0755 "$(PROJECT_DIR)/bin/superterm" "$(DESTDIR)$(BINDIR)/superterm"
	install -m 0644 "$(PROJECT_DIR)/README.md" "$(DESTDIR)$(DOCDIR)/README.md"
	@for doc in "$(PROJECT_DIR)"/docs/*.md; do \
		install -m 0644 "$$doc" "$(DESTDIR)$(DOCDIR)/$$(basename "$$doc")"; \
	done
	@mkdir -p "$(DESTDIR)$(DATADIR)/backgrounds"
	@rm -f "$(DESTDIR)$(DATADIR)"/backgrounds/*.art
	@for art in "$(PROJECT_DIR)"/backgrounds/*.art; do \
		install -m 0644 "$$art" "$(DESTDIR)$(DATADIR)/backgrounds/$$(basename "$$art")"; \
	done
	@printf '%s\n' "Desktop backgrounds installed in $(DATADIR)/backgrounds"
	@if [ ! -f "$(DESTDIR)$(SYSCONFDIR)/superterm/superterm.ini" ]; then \
		install -m 0644 "$(PROJECT_DIR)/examples/superterm.ini.example" \
			"$(DESTDIR)$(SYSCONFDIR)/superterm/superterm.ini.example"; \
	else \
		printf '%s\n' "Keeping existing $(SYSCONFDIR)/superterm/superterm.ini"; \
	fi

uninstall:
	rm -f "$(DESTDIR)$(BINDIR)/superterm"
	rm -f "$(DESTDIR)$(DOCDIR)/README.md" "$(DESTDIR)$(DOCDIR)/BUILDING.md" \
		"$(DESTDIR)$(DOCDIR)/CONFIGURATION.md" "$(DESTDIR)$(DOCDIR)/WIZARD.md"
	rm -f "$(DESTDIR)$(SYSCONFDIR)/superterm/superterm.ini.example"
	rm -rf "$(DESTDIR)$(DATADIR)/backgrounds"

install-deps:
	@if [ "$$(uname -s)" = "Darwin" ]; then \
		if ! command -v brew >/dev/null 2>&1; then \
			printf '%s\n' 'Homebrew is required for automatic setup on macOS (https://brew.sh).'; exit 1; fi; \
		command -v fpc >/dev/null 2>&1 || brew install fpc; \
		printf '%s\n' 'libsqlite3 ships with macOS; no package needed.'; \
		python3 -m pip install --user pyte >/dev/null 2>&1 || \
			printf '%s\n' 'Optional: "pip3 install pyte" enables "make test".'; \
		printf '%s\n' 'Optional: "brew install sshpass" only for password-auth SSH panes.'; \
	elif command -v apt-get >/dev/null 2>&1; then \
		if [ "$$(id -u)" -eq 0 ]; then SUDO=; \
		elif command -v sudo >/dev/null 2>&1; then SUDO=sudo; \
		else printf '%s\n' 'sudo is required'; exit 1; fi; \
		$$SUDO apt-get update && $$SUDO apt-get install -y \
			fp-compiler fp-units-fv fp-units-fcl fp-units-db make \
			python3 python3-pyte openssh-client sshpass; \
	else \
		printf '%s\n' 'Automatic dependency installation is only implemented for Debian/Ubuntu and macOS (Homebrew).'; \
		exit 1; \
	fi

clean:
	rm -rf "$(PROJECT_DIR)/build"
	rm -f "$(PROJECT_DIR)"/bin/*

distclean: clean
	rm -f "$(PROJECT_DIR)/Makefile" "$(PROJECT_DIR)/config.status"

info:
	@printf 'FPC:       %s\n' "$(FPC)"
	@printf 'Mode:      %s\n' "$(MODE)"
	@printf 'Target:    %s\n' "$(TARGET)"
	@printf 'Prefix:    %s\n' "$(PREFIX)"
	@printf 'Config:    %s\n' "$(SYSCONFDIR)/superterm"
	@printf 'Docs:      %s\n' "$(DOCDIR)"
