SHELL := /bin/sh

PROJECT_DIR := @PROJECT_DIR@
FPC := @FPC@
PYTHON := @PYTHON@
# DESTDIR: the standard staging prefix every packaging tool sets. Without it
# 'make install' wrote to the real /usr even inside a fakeroot, so no package
# could be built from this Makefile.
DESTDIR ?=
PREFIX := @PREFIX@
BINDIR := @BINDIR@
SYSCONFDIR := @SYSCONFDIR@
DOCDIR := @DOCDIR@
DATADIR := @DATADIR@

MODE ?= release
TARGET ?= $(PROJECT_DIR)/bin/superterm
UNITDIR ?= $(PROJECT_DIR)/build/units/$(MODE)
FPCFLAGS_EXTRA ?=
TEST_TARGET := $(PROJECT_DIR)/bin/superterm-test

# -vewnh: errors, warnings, notes and hints all on -- the project builds with
# none of them. -vm11030,11031 silences the two FPC emits about reading its
# own /etc/fpc.cfg, which say nothing about this code and made a clean build
# look like it had something to report.
BASE_FLAGS := -Mobjfpc -Sh -vewnh -vm11030,11031 \
  -Fu$(PROJECT_DIR)/vendor/fv322 \
  -FU$(UNITDIR) \
  -FE$(PROJECT_DIR)/bin

ifeq ($(MODE),debug)
# -Crtoi explicito: /etc/fpc.cfg lo activa via su rama "#IFDEF DEBUG", pero
# el build no debe depender del config global para sus checks de runtime
MODE_FLAGS := -O1 -g -gl -dDEBUG -Crtoi
else ifeq ($(MODE),release)
# -gl: line information, kept in the optimised build on purpose. A crash
# report from a release binary carried bare addresses that resolved to
# nothing, which is exactly when the report matters most; with this the
# backtrace names the file and line. It does not change the code generated.
MODE_FLAGS := -O4 -gl
else
$(error MODE must be release or debug)
endif

SOURCES := $(wildcard $(PROJECT_DIR)/src/*.pas) \
  $(wildcard $(PROJECT_DIR)/src/*.lpr) \
  $(wildcard $(PROJECT_DIR)/vendor/fv322/*.pas) \
  $(wildcard $(PROJECT_DIR)/vendor/fv322/*.inc)

TESTS := suite_manifest_test.py \
  drive_test.py large_screen_test.py mouse_test.py \
  mouse_focus_test.py focus_color_test.py palette_resize_transition_test.py \
  class_creation_transition_test.py \
  restore_test.py sysconfig_test.py \
  template_test.py sqlite_test.py wizard_test.py language_test.py clipboard_test.py \
  window_test.py cursor_test.py wclass_test.py profile_test.py \
  profile_default_test.py profile_shell_fallback_test.py \
  profile_switch_transition_test.py multisession_test.py \
  prefix_test.py title_test.py \
  detach_test.py control_test.py cli_test.py cli_help_test.py control_wm_test.py \
  nonblocking_server_test.py attach_progress_budget_test.py \
  global_command_fifo_test.py sidecar_atomic_test.py \
  client_egress_nonblocking_test.py \
  global_lock_queue_test.py \
  multiclient_input_burst_test.py \
  multithread_server_test.py \
  multiclient_test.py multiclient_close_test.py shared_geometry_test.py \
  host_resize_shared_test.py desktop_resize_protocol_test.py \
  desktop_persistence_test.py \
  maximize_min_viewport_test.py \
  zoom_exclusive_switch_test.py \
  host_summary_lease_test.py \
  client_notifications_test.py \
  shared_state_stress_test.py multiclient_intensive_test.py \
  multiclient_focus_test.py multiclient_minimize_test.py \
  layout_transition_test.py layout_preview_protocol_test.py wireframe_preview_test.py \
  concurrent_gesture_test.py \
  restore_focus_test.py title_hold_focus_test.py alwaysserver_test.py \
  passthrough_test.py passthrough_multiclient_test.py f5_output_layout_order_test.py \
  exit_clean_test.py newwindow_test.py appcursor_test.py late_dsr_test.py \
  terminal_encoding_test.py \
  scrollback_test.py nesting_test.py mouseforward_test.py \
  remote_newpane_test.py fullscreen_test.py empty_desktop_test.py \
  max_panes_test.py close_all_panes_test.py \
  mousemode_test.py dialog_opaque_test.py background_assets_test.py \
  fresh_install_defaults_test.py \
  badclass_test.py passthrough_modes_test.py resize_keep_test.py \
  config_concurrency_test.py \
  pane_reaper_test.py pty_spawn_safety_test.py session_startup_atomic_test.py \
  stlib_crash_audit_test.py stlib_transition_capture_test.py \
  daemon_identity_safety_test.py \
  new_session_profile_test.py ssh_server_config_test.py \
  ssh_release_boundary_test.py \
  ssh_service_uninstall_test.py ssh_entry_test.py \
  ssh_transport_test.py

.PHONY: all release debug debug-heap test-runtime test install uninstall install-deps clean distclean info

all: $(TARGET)

# la version se toma del fichero VERSION y se inyecta como include
$(PROJECT_DIR)/src/st_version.inc: $(PROJECT_DIR)/VERSION
	printf "const SUPERTERM_VERSION = '%s';\n" "$$(cat $(PROJECT_DIR)/VERSION)" \
		> $(PROJECT_DIR)/src/st_version.inc

$(TARGET): $(SOURCES) $(PROJECT_DIR)/src/st_version.inc $(PROJECT_DIR)/config.status
	@mkdir -p "$(UNITDIR)" "$(PROJECT_DIR)/bin"
	$(FPC) $(BASE_FLAGS) $(MODE_FLAGS) $(FPCFLAGS_EXTRA) \
		-o$(TARGET) $(PROJECT_DIR)/src/superterm.lpr

release:
	$(MAKE) MODE=release TARGET=$(PROJECT_DIR)/bin/superterm all

debug:
	$(MAKE) MODE=debug TARGET=$(PROJECT_DIR)/bin/superterm-debug all

# Separate instrumented binary: -gh installs FPC's HeapTrc memory manager and
# SUPERTERM_HEAPTRACE gives st_debug permission to redirect every process to a
# distinct, PID-tagged dump. Keeping it separate avoids changing normal debug
# timing and memory layout when a race/deadlock is being reproduced.
debug-heap:
	$(MAKE) MODE=debug TARGET=$(PROJECT_DIR)/bin/superterm-debug-heap \
		UNITDIR=$(PROJECT_DIR)/build/units/debug-heap \
		FPCFLAGS_EXTRA='$(FPCFLAGS_EXTRA) -gh -dSUPERTERM_HEAPTRACE' all

# Test-only path/executable overrides must never be present in the installed
# root administration binary.  A separate target and unit directory prevent
# FPC from reusing units compiled with a different conditional symbol.
test-runtime:
	$(MAKE) MODE=release TARGET=$(TEST_TARGET) \
		UNITDIR=$(PROJECT_DIR)/build/units/test-runtime \
		FPCFLAGS_EXTRA='$(FPCFLAGS_EXTRA) -dSUPERTERM_TEST_BUILD' all

test: release test-runtime
	@if [ -z "$(PYTHON)" ]; then \
		printf '%s\n' 'Python 3 is required for tests'; exit 1; \
	fi
	@$(PYTHON) -c 'import pyte, PIL' 2>/dev/null || \
		(printf '%s\n' 'Python modules pyte and Pillow are required; install python3-pyte python3-pil or run pip install pyte pillow'; exit 1)
	@command -v rsvg-convert >/dev/null 2>&1 || \
		(printf '%s\n' 'rsvg-convert is required for artwork tests; install librsvg2-bin (Debian/Ubuntu) or librsvg (Homebrew)'; exit 1)
	@SUPERTERM_TEST_BIN="$(TEST_TARGET)" \
		SUPERTERM_RELEASE_BIN="$(PROJECT_DIR)/bin/superterm" \
		FPC="$(FPC)" \
		$(PYTHON) "$(PROJECT_DIR)/test/run_tests.py" \
		--project-dir "$(PROJECT_DIR)" $(TESTS)

# Regenerate this Makefile when its template or configure changes. An existing
# checkout otherwise keeps a stale Makefile after a pull -- which is how a new
# install path (the desktop backgrounds directory) silently went missing.
Makefile: $(PROJECT_DIR)/Makefile.in $(PROJECT_DIR)/configure
	@printf '%s\n' "Makefile.in or configure changed; re-running ./configure"
	@cd "$(PROJECT_DIR)" && ./configure

install: release
	@mkdir -p "$(DESTDIR)$(BINDIR)" "$(DESTDIR)$(DOCDIR)" "$(DESTDIR)$(SYSCONFDIR)/superterm"
	install -m 0755 "$(PROJECT_DIR)/bin/superterm" "$(DESTDIR)$(BINDIR)/superterm"
	install -m 0644 "$(PROJECT_DIR)/README.md" "$(DESTDIR)$(DOCDIR)/README.md"
	@for doc in "$(PROJECT_DIR)"/docs/*.md; do \
		install -m 0644 "$$doc" "$(DESTDIR)$(DOCDIR)/$$(basename "$$doc")"; \
	done
	@mkdir -p "$(DESTDIR)$(DATADIR)/backgrounds"
	@rm -f "$(DESTDIR)$(DATADIR)"/backgrounds/*.art
	@for art in "$(PROJECT_DIR)"/backgrounds/*.art; do \
		install -m 0644 "$$art" "$(DESTDIR)$(DATADIR)/backgrounds/$$(basename "$$art")"; \
	done
	@printf '%s\n' "Desktop backgrounds installed in $(DATADIR)/backgrounds"
	@if [ ! -f "$(DESTDIR)$(SYSCONFDIR)/superterm/superterm.ini" ]; then \
		install -m 0644 "$(PROJECT_DIR)/examples/superterm.ini.example" \
			"$(DESTDIR)$(SYSCONFDIR)/superterm/superterm.ini.example"; \
	else \
		printf '%s\n' "Keeping existing $(SYSCONFDIR)/superterm/superterm.ini"; \
	fi

uninstall:
	@if [ -z "$(DESTDIR)" ]; then \
		if [ "$$(id -u)" -ne 0 ] && \
		   { [ "$${SUPERTERM_TESTING:-}" != 1 ] || \
		     [ -z "$${SUPERTERM_SSHD_ROOT:-}" ]; }; then \
			printf '%s\n' 'Unprivileged uninstall: host SSH service state was not touched.'; \
		elif [ -x "$(BINDIR)/superterm" ]; then \
			"$(BINDIR)/superterm" ssh-server uninstall-service || exit $$?; \
		elif [ -e "$(BINDIR)/superterm" ]; then \
			printf '%s\n' 'Refusing to remove a non-executable SuperTerm binary before its SSH service is uninstalled.' >&2; \
			exit 1; \
		else \
			printf '%s\n' 'SuperTerm binary is already absent; no host service state was touched.'; \
		fi; \
	else \
		printf '%s\n' 'DESTDIR staging uninstall: host SSH service state is not touched.'; \
	fi
	rm -f "$(DESTDIR)$(BINDIR)/superterm"
	rm -f "$(DESTDIR)$(DOCDIR)/README.md"
	@for doc in "$(PROJECT_DIR)"/docs/*.md; do \
		rm -f "$(DESTDIR)$(DOCDIR)/$$(basename "$$doc")"; \
	done
	rm -f "$(DESTDIR)$(SYSCONFDIR)/superterm/superterm.ini.example"
	rm -rf "$(DESTDIR)$(DATADIR)/backgrounds"

install-deps:
	@if [ "$$(uname -s)" = "Darwin" ]; then \
		if ! command -v brew >/dev/null 2>&1; then \
			printf '%s\n' 'Homebrew is required for automatic setup on macOS (https://brew.sh).'; exit 1; fi; \
		command -v fpc >/dev/null 2>&1 || brew install fpc; \
		command -v python3 >/dev/null 2>&1 || brew install python; \
		printf '%s\n' 'libsqlite3 ships with macOS; no package needed.'; \
		python3 -m pip install --user pyte pillow >/dev/null 2>&1 || \
			printf '%s\n' 'Optional: "pip3 install pyte pillow" enables "make test".'; \
		command -v rsvg-convert >/dev/null 2>&1 || brew install librsvg; \
		printf '%s\n' 'Optional: "brew install sshpass" only for password-auth SSH panes.'; \
	elif command -v apt-get >/dev/null 2>&1; then \
		if [ "$$(id -u)" -eq 0 ]; then SUDO=; \
		elif command -v sudo >/dev/null 2>&1; then SUDO=sudo; \
		else printf '%s\n' 'sudo is required'; exit 1; fi; \
		$$SUDO apt-get update && $$SUDO apt-get install -y \
			fp-compiler fp-units-fv fp-units-fcl fp-units-db fp-units-misc make \
			python3 python3-pyte python3-pil librsvg2-bin \
			openssh-client openssh-server sshpass; \
	else \
		printf '%s\n' 'Automatic dependency installation is only implemented for Debian/Ubuntu and macOS (Homebrew).'; \
		exit 1; \
	fi

clean:
	rm -rf "$(PROJECT_DIR)/build"
	rm -f "$(PROJECT_DIR)"/bin/*

distclean: clean
	rm -f "$(PROJECT_DIR)/Makefile" "$(PROJECT_DIR)/config.status"

info:
	@printf 'FPC:       %s\n' "$(FPC)"
	@printf 'Mode:      %s\n' "$(MODE)"
	@printf 'Target:    %s\n' "$(TARGET)"
	@printf 'Prefix:    %s\n' "$(PREFIX)"
	@printf 'Config:    %s\n' "$(SYSCONFDIR)/superterm"
	@printf 'Docs:      %s\n' "$(DOCDIR)"
